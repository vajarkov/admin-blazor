
@page "/nabor/words/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using admin_blazor.Data
@using admin_blazor.Models
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db

<PageTitle>Слова набора</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-4">
        <a href="/nabor" class="btn btn-outline-secondary btn-sm mb-3">
            Назад к наборам
        </a>

        <h2 class="mb-1">Слова и переводы</h2>

        @if (nabor is not null)
        {
            <div class="text-muted">
                Набор: <strong>@nabor.Word</strong>
                <span class="ms-2">ID: @nabor.Id</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Загрузка данных...</p>
    }
    else if (nabor is null)
    {
        <div class="alert alert-warning">
            Набор не найден.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Добавить слово</h5>
            </div>

            <div class="card-body">
                @if (Id > byte.MaxValue)
                {
                    <div class="alert alert-warning mb-0">
                        ID этого набора превышает 255. В существующей таблице
                        naborshikwords поле wordid имеет тип tinyint unsigned,
                        поэтому сохранить связь с этим набором невозможно
                        без изменения структуры базы данных.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="english" class="form-label">
                                Английский
                            </label>

                            <input id="english"
                                   class="form-control"
                                   maxlength="191"
                                   @bind="english"
                                   @bind:event="oninput"
                                   placeholder="English word" />
                        </div>

                        <div class="col-md-5">
                            <label for="russian" class="form-label">
                                Русский
                            </label>

                            <input id="russian"
                                   class="form-control"
                                   maxlength="191"
                                   @bind="russian"
                                   @bind:event="oninput"
                                   placeholder="Перевод" />
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    disabled="@isSaving"
                                    @onclick="AddWordAsync">
                                Добавить
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Все слова</h5>
            </div>

            <div class="card-body">
                @if (words.Count == 0)
                {
                    <p class="text-muted mb-0">
                        Для этого набора пока нет слов.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Английский</th>
                                    <th>Перевод</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var word in words)
                                {
                                    <tr @key="word.Id">
                                        <td>@word.Id</td>
                                        <td>@word.En</td>
                                        <td>@word.Rus</td>
                                        <td>
                                            @if (pendingDeleteId == word.Id)
                                            {
                                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                                    <span class="text-danger">
                                                        Удалить запись?
                                                    </span>

                                                    <button class="btn btn-sm btn-danger"
                                                            disabled="@isSaving"
                                                            @onclick="() => DeleteWordAsync(word.Id)">
                                                        Подтвердить
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            @onclick="CancelDelete">
                                                        Отмена
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => AskDelete(word.Id)">
                                                    Удалить
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private NaborItem? nabor;
    private List<NaborshikWord> words = new();

    private string english = string.Empty;
    private string russian = string.Empty;

    private uint? pendingDeleteId;

    private bool isLoading = true;
    private bool isSaving;

    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (Id <= 0)
            {
                nabor = null;
                words.Clear();
                return;
            }

            nabor = await Db.Nabors
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == (uint)Id);

            if (nabor is null || Id > byte.MaxValue)
            {
                words.Clear();
                return;
            }

            byte wordId = (byte)Id;

            words = await Db.NaborshikWords
                .AsNoTracking()
                .Where(x => x.Wordid == wordId)
                .OrderBy(x => x.Id)
                .ToListAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось загрузить слова набора.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddWordAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (nabor is null || Id <= 0 || Id > byte.MaxValue)
        {
            errorMessage = "Невозможно добавить слово для этого набора.";
            return;
        }

        var en = english.Trim();
        var ru = russian.Trim();

        if (string.IsNullOrWhiteSpace(en) ||
            string.IsNullOrWhiteSpace(ru))
        {
            errorMessage = "Заполни оба поля: английское слово и перевод.";
            return;
        }

        if (en.Length > 191 || ru.Length > 191)
        {
            errorMessage = "Каждое поле должно содержать не более 191 символа.";
            return;
        }

        isSaving = true;

        try
        {
            Db.NaborshikWords.Add(new NaborshikWord
            {
                En = en,
                Rus = ru,
                Wordid = (byte)Id
            });

            await Db.SaveChangesAsync();

            english = string.Empty;
            russian = string.Empty;

            successMessage = "Слово и перевод добавлены.";

            await LoadDataAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось сохранить слово и перевод.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(uint id)
    {
        pendingDeleteId = id;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
    }

    private async Task DeleteWordAsync(uint id)
    {
        if (pendingDeleteId != id)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            var word = await Db.NaborshikWords
                .FirstOrDefaultAsync(x => x.Id == id);

            if (word is null || word.Wordid != (byte?)Id)
            {
                errorMessage = "Запись не найдена в этом наборе.";
                return;
            }

            Db.NaborshikWords.Remove(word);

            await Db.SaveChangesAsync();

            pendingDeleteId = null;
            successMessage = "Запись удалена.";

            await LoadDataAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось удалить запись.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
