
@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using admin_blazor.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Проверка базы данных</PageTitle>

<h1>Пользователи</h1>

@if (users is null)
{
    <p>Загрузка...</p>
}
else
{
    <p>Всего записей: @users.Count</p>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Фамилия</th>
                <th>Номер телефона</th>
                <th>Тип пользователя</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Surname</td>
                    <td>@user.Phone</td>
                    <td>@user.UserType</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UserRow>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await Db.Users
            .AsNoTracking()
            .OrderBy(u => u.Id)
            .Select(u => new UserRow(
                u.Id, u.Name, u.Surname, u.Phone, u.UserType))
            .ToListAsync();
    }

    private record UserRow(
        uint Id, string? Name, string? Surname, double? Phone, uint? UserType);
}
