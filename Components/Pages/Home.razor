
@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using admin_blazor.Data
@using admin_blazor.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Globalization
@inject AppDbContext Db
@inject IJSRuntime JS

<PageTitle>Главная</PageTitle>

<h3 class="mb-4">Главная</h3>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else
{
    <div class="row g-4 align-items-stretch">
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">Цена LVL</h5>
                </div>

                <div class="card-body d-flex flex-column">
                    <EditForm Model="@priceForm"
                              OnValidSubmit="@SavePriceAsync"
                              class="d-flex flex-column flex-grow-1">
                        <div class="mb-3">
                            <label for="priceKzt" class="form-label">
                                Цена в KZT
                            </label>

                            <InputNumber TValue="int"
                                         id="priceKzt"
                                         class="form-control"
                                         min="0"
                                         @bind-Value="priceForm.PriceKzt" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 mt-auto">
                            Сохранить
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert @statusClass mt-3 mb-0" role="alert">
                            @statusMessage
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">Пополнить баланс</h5>
                </div>

                <div class="card-body d-flex flex-column">
                    <EditForm Model="@balanceForm"
                              OnValidSubmit="@SearchUserAsync"
                              class="d-flex flex-column">
                        <div class="mb-3 position-relative">
                            <label for="userSearch" class="form-label">
                                Поиск пользователя по ФИО или ID
                            </label>

                            <input id="userSearch"
                                   type="text"
                                   class="form-control"
                                   placeholder="Введите имя, фамилию или ID"
                                   autocomplete="off"
                                   value="@userSearchText"
                                   @oninput="OnUserSearchInputAsync" />

                            @if (userSuggestions.Count > 0)
                            {
                                <div class="list-group position-absolute w-100 shadow"
                                     style="z-index: 1050; max-height: 240px; overflow-y: auto;">
                                    @foreach (var user in userSuggestions)
                                    {
                                        <button @key="user.Id"
                                                type="button"
                                                class="list-group-item list-group-item-action"
                                                @onclick="() => SelectUserAsync(user)">
                                            <span class="d-block">
                                                @user.Name @user.Surname
                                            </span>
                                            <small class="text-muted">
                                                ID: @user.Id
                                            </small>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Найти пользователя
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrWhiteSpace(balanceMessage))
                    {
                        <div class="alert @balanceMessageClass mt-3 mb-0"
                             role="alert">
                            @balanceMessage
                        </div>
                    }

                    @if (selectedUser is not null)
                    {
                        <hr class="my-4" />

                        <h6>
                            @selectedUser.Name @selectedUser.Surname
                        </h6>

                        <p class="mb-3">
                            ID: @selectedUser.Id
                            <br />
                            Текущий баланс:
                            <strong>@(selectedUser.Balance ?? "0") LVL</strong>
                        </p>

                        <EditForm Model="@topUpForm"
                                  OnValidSubmit="@TopUpBalanceAsync">
                            <div class="mb-3">
                                <label for="amountLvl" class="form-label">
                                    Сумма пополнения (LVL)
                                </label>

                                <InputNumber TValue="decimal"
                                             id="amountLvl"
                                             class="form-control"
                                             min="0.01"
                                             step="0.01"
                                             @bind-Value="topUpForm.AmountLvl" />
                            </div>

                            <div class="mb-3">
                                <label for="cancellationDate" class="form-label">
                                    Дата аннулирования
                                </label>

                                <InputDate TValue="DateTime?"
                                           id="cancellationDate"
                                           class="form-control"
                                           @bind-Value="topUpForm.CancellationDate" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    disabled="@isSavingTopUp">
                                @(isSavingTopUp ? "Сохранение..." : "Пополнить баланс")
                            </button>
                        </EditForm>

                        @if (!string.IsNullOrWhiteSpace(topUpMessage))
                        {
                            <div class="alert @topUpMessageClass mt-3 mb-0"
                                 role="alert">
                                @topUpMessage
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSavingTopUp;

    private PriceForm priceForm = new();
    private BalanceForm balanceForm = new();
    private TopUpForm topUpForm = new();

    private User? selectedUser;
    private List<User> userSuggestions = new();
    private string userSearchText = string.Empty;

    private string? statusMessage;
    private string statusClass = "alert-success";

    private string? balanceMessage;
    private string balanceMessageClass = "alert-info";

    private string? topUpMessage;
    private string topUpMessageClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var config = await Db.Configs
                .AsNoTracking()
                .SingleOrDefaultAsync(c => c.Id == 1);

            priceForm.PriceKzt = config?.PriceKzt is uint price
                ? checked((int)price)
                : 0;
        }
        catch
        {
            statusClass = "alert-danger";
            statusMessage = "Не удалось загрузить текущую цену LVL.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SavePriceAsync()
    {
        statusMessage = null;

        if (priceForm.PriceKzt < 0)
        {
            statusClass = "alert-danger";
            statusMessage = "Цена не может быть отрицательной.";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Вы уверены, что хотите сохранить новую цену LVL?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            var config = await Db.Configs
                .SingleOrDefaultAsync(c => c.Id == 1);

            if (config is null)
            {
                config = new Config
                {
                    Id = 1,
                    PriceKzt = (uint)priceForm.PriceKzt
                };

                Db.Configs.Add(config);
            }
            else
            {
                config.PriceKzt = (uint)priceForm.PriceKzt;
            }

            await Db.SaveChangesAsync();

            statusClass = "alert-success";
            statusMessage = "Цена LVL успешно сохранена.";
        }
        catch
        {
            statusClass = "alert-danger";
            statusMessage = "Не удалось сохранить цену LVL.";
        }
    }

    private async Task OnUserSearchInputAsync(ChangeEventArgs args)
    {
        userSearchText = args.Value?.ToString() ?? string.Empty;

        userSuggestions.Clear();
        selectedUser = null;
        balanceMessage = null;
        topUpMessage = null;

        var search = userSearchText.Trim();

        if (search.Length < 2)
        {
            return;
        }

        try
        {
            if (uint.TryParse(search, out var id))
            {
                if (id == 0)
                {
                    return;
                }

                var user = await Db.Users
                    .AsNoTracking()
                    .Where(u => u.Id == id)
                    .Select(u => new User
                    {
                        Id = u.Id,
                        Name = u.Name,
                        Surname = u.Surname,
                        Balance = u.Balance
                    })
                    .SingleOrDefaultAsync();

                if (user is not null)
                {
                    userSuggestions.Add(user);
                }

                return;
            }

            userSuggestions = await BuildNameSearchQuery(search)
                .OrderBy(u => u.Name)
                .ThenBy(u => u.Surname)
                .Take(10)
                .Select(u => new User
                {
                    Id = u.Id,
                    Name = u.Name,
                    Surname = u.Surname,
                    Balance = u.Balance
                })
                .ToListAsync();
        }
        catch
        {
            userSuggestions.Clear();
            balanceMessageClass = "alert-danger";
            balanceMessage = "Не удалось выполнить поиск. Проверьте подключение к базе данных.";
        }
    }

    private IQueryable<User> BuildNameSearchQuery(string search)
    {
        var terms = search.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        var query = Db.Users.AsNoTracking();

        if (terms.Length >= 2)
        {
            var first = terms[0];
            var second = terms[1];

            query = query.Where(u =>
                u.Name != null &&
                u.Surname != null &&
                (
                    (u.Name.Contains(first) &&
                     u.Surname.Contains(second)) ||
                    (u.Name.Contains(second) &&
                     u.Surname.Contains(first))
                ));
        }
        else
        {
            query = query.Where(u =>
                (u.Name != null && u.Name.Contains(search)) ||
                (u.Surname != null && u.Surname.Contains(search)));
        }

        return query;
    }

    private async Task SearchUserAsync()
    {
        selectedUser = null;
        balanceMessage = null;
        topUpMessage = null;
        topUpForm = new TopUpForm();
        userSuggestions.Clear();

        var search = userSearchText.Trim();

        if (string.IsNullOrWhiteSpace(search))
        {
            balanceMessageClass = "alert-danger";
            balanceMessage = "Введите ФИО или ID пользователя.";
            return;
        }

        try
        {
            if (uint.TryParse(search, out var id))
            {
                if (id > 0)
                {
                    selectedUser = await Db.Users
                        .AsNoTracking()
                        .SingleOrDefaultAsync(u => u.Id == id);
                }
            }
            else
            {
                var matches = await BuildNameSearchQuery(search)
                    .Take(2)
                    .ToListAsync();

                if (matches.Count == 1)
                {
                    selectedUser = matches[0];
                }
                else if (matches.Count > 1)
                {
                    userSuggestions = matches;

                    balanceMessageClass = "alert-info";
                    balanceMessage = "Найдено несколько пользователей. Выберите нужного из списка.";
                    return;
                }
            }

            if (selectedUser is null)
            {
                balanceMessageClass = "alert-warning";
                balanceMessage = "Пользователь не найден.";
                return;
            }

            balanceForm.UserId = checked((int)selectedUser.Id);
            userSearchText =
                $"{selectedUser.Name} {selectedUser.Surname}";

            balanceMessageClass = "alert-success";
            balanceMessage = "Пользователь найден.";
        }
        catch (OverflowException)
        {
            balanceMessageClass = "alert-danger";
            balanceMessage = "ID пользователя превышает допустимый диапазон.";
        }
        catch
        {
            balanceMessageClass = "alert-danger";
            balanceMessage = "Не удалось найти пользователя. Проверьте подключение к базе данных.";
        }
    }

    private async Task SelectUserAsync(User user)
    {
        try
        {
            selectedUser = await Db.Users
                .AsNoTracking()
                .SingleOrDefaultAsync(u => u.Id == user.Id);

            userSuggestions.Clear();
            topUpForm = new TopUpForm();
            topUpMessage = null;

            if (selectedUser is null)
            {
                balanceMessageClass = "alert-warning";
                balanceMessage = "Пользователь больше не найден.";
                return;
            }

            balanceForm.UserId = checked((int)selectedUser.Id);
            userSearchText =
                $"{selectedUser.Name} {selectedUser.Surname}";

            balanceMessageClass = "alert-success";
            balanceMessage = "Пользователь найден.";
        }
        catch (OverflowException)
        {
            selectedUser = null;
            balanceMessageClass = "alert-danger";
            balanceMessage = "ID пользователя превышает допустимый диапазон.";
        }
        catch
        {
            selectedUser = null;
            balanceMessageClass = "alert-danger";
            balanceMessage = "Не удалось загрузить данные пользователя.";
        }
    }

    private async Task TopUpBalanceAsync()
    {
        topUpMessage = null;

        if (selectedUser is null)
        {
            topUpMessageClass = "alert-danger";
            topUpMessage = "Сначала найдите пользователя.";
            return;
        }

        if (topUpForm.AmountLvl <= 0)
        {
            topUpMessageClass = "alert-danger";
            topUpMessage = "Сумма пополнения должна быть больше нуля.";
            return;
        }

        if (topUpForm.CancellationDate is null)
        {
            topUpMessageClass = "alert-danger";
            topUpMessage = "Укажите дату аннулирования.";
            return;
        }

        var cancellationLocal = DateTime.SpecifyKind(
            topUpForm.CancellationDate.Value.Date,
            DateTimeKind.Local);

        var cancellationTimestamp =
            new DateTimeOffset(cancellationLocal).ToUnixTimeSeconds();

        if (cancellationTimestamp < 0 ||
            cancellationTimestamp > uint.MaxValue)
        {
            topUpMessageClass = "alert-danger";
            topUpMessage = "Указанная дата аннулирования вне допустимого диапазона.";
            return;
        }

        isSavingTopUp = true;

        try
        {
            await using var transaction =
                await Db.Database.BeginTransactionAsync();

            var user = await Db.Users
                .SingleOrDefaultAsync(u => u.Id == selectedUser.Id);

            if (user is null)
            {
                await transaction.RollbackAsync();

                selectedUser = null;
                balanceMessageClass = "alert-warning";
                balanceMessage = "Пользователь больше не найден. Выполните поиск повторно.";
                return;
            }

            decimal currentBalance = 0;

            if (!string.IsNullOrWhiteSpace(user.Balance) &&
                !decimal.TryParse(
                    user.Balance,
                    NumberStyles.Number,
                    CultureInfo.InvariantCulture,
                    out currentBalance) &&
                !decimal.TryParse(
                    user.Balance,
                    NumberStyles.Number,
                    CultureInfo.CurrentCulture,
                    out currentBalance))
            {
                await transaction.RollbackAsync();

                topUpMessageClass = "alert-danger";
                topUpMessage = "Текущий баланс пользователя имеет неверный формат. Пополнение не выполнено.";
                return;
            }

            var newBalance = currentBalance + topUpForm.AmountLvl;

            user.Balance = newBalance.ToString(
                CultureInfo.InvariantCulture);

            var log = new Logspay
            {
                Time = checked((uint)DateTimeOffset.UtcNow.ToUnixTimeSeconds()),
                UserId = user.Id,
                Cancellation = (uint)cancellationTimestamp,
                Lvl = (double)topUpForm.AmountLvl,
                Kzt = null
            };

            Db.Logspays.Add(log);

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            selectedUser = new User
            {
                Id = user.Id,
                Name = user.Name,
                Surname = user.Surname,
                Balance = user.Balance
            };

            topUpMessageClass = "alert-success";
            topUpMessage = $"Баланс успешно пополнен на {topUpForm.AmountLvl.ToString(CultureInfo.InvariantCulture)} LVL.";
            topUpForm = new TopUpForm();
        }
        catch
        {
            topUpMessageClass = "alert-danger";
            topUpMessage = "Не удалось пополнить баланс. Изменения не были подтверждены.";
        }
        finally
        {
            isSavingTopUp = false;
        }
    }

    private sealed class PriceForm
    {
        public int PriceKzt { get; set; }
    }

    private sealed class BalanceForm
    {
        public int UserId { get; set; }
    }

    private sealed class TopUpForm
    {
        public decimal AmountLvl { get; set; }
        public DateTime? CancellationDate { get; set; }
    }
}
