@page "/dictionary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using admin_blazor.Data
@using admin_blazor.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<PageTitle>Словарь</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="mb-1">Словарь</h3>
            <div class="text-muted">Английские слова и русские переводы</div>
        </div>

        <button type="button" class="btn btn-primary" @onclick="StartCreate">
            Добавить слово
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success alert-dismissible">
            @message
            <button type="button" class="btn-close" aria-label="Закрыть" @onclick="() => message = null">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (showForm)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    @(editingId.HasValue ? "Редактирование слова" : "Добавление слова")
                </h5>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label for="englishWord" class="form-label">Английский</label>
                    <input id="englishWord" type="text" class="form-control" @bind="englishWord" maxlength="10000"
                           placeholder="Введите английское слово" />
                </div>

                <div class="mb-3">
                    <label for="russianTranslation" class="form-label">Русский перевод</label>
                    <input id="russianTranslation" type="text" class="form-control" @bind="russianTranslation"
                           maxlength="10000" placeholder="Введите перевод" />
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" disabled="@isSaving" @onclick="SaveWordAsync">
                        @(isSaving ? "Сохранение..." : "Сохранить")
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CancelForm">
                        Отмена
                    </button>
                </div>
            </div>
        </div>
    }

    @if (deletingWordId.HasValue)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-3">
            <span>
                Удалить слово
                <strong>@deletingWordText</strong>?
                Это действие нельзя отменить.
            </span>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger btn-sm" disabled="@isDeleting" @onclick="ConfirmDeleteAsync">
                    @(isDeleting ? "Удаление..." : "Удалить")
                </button>

                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isDeleting"
                        @onclick="CancelDelete">
                    Отмена
                </button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-8 col-lg-6">
                    <input type="search" class="form-control" placeholder="Поиск по английскому слову или переводу..."
                           @bind="searchText" @bind:event="oninput" />
                </div>

                <div class="col-12 col-md-auto d-flex align-items-center">
                    <span class="text-muted">
                        Найдено: @FilteredWords.Count()
                    </span>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <div class="text-muted mt-2">Загружаем словарь...</div>
                </div>
            }
            else if (FilteredWords.Count() == 0)
            {
                <div class="text-center text-muted py-4">
                    @if (words.Count == 0)
                    {
                        <span>В словаре пока нет слов.</span>
                    }
                    else
                    {
                        <span>По вашему запросу ничего не найдено.</span>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 70px;">№</th>
                                <th>Английский</th>
                                <th>Русский</th>
                                <th style="width: 140px;">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var number = 1;
                            }

                            @foreach (var word in FilteredWords)
                            {
                                <tr @key="word.Id">
                                    <td>@number</td>
                                    <td>@word.EnglishWord</td>
                                    <td>@word.RussianTranslation</td>
                                    <td>
                                        
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-primary" title="Редактировать"
                                                    aria-label="Редактировать" @onclick="() => StartEdit(word)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M12 20h9" />
                                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                                </svg>
                                            </button>

                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Удалить"
                                                    aria-label="Удалить" @onclick="() => StartDelete(word)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 6h18" />
                                                    <path d="M8 6V4h8v2" />
                                                    <path d="M19 6l-1 14H6L5 6" />
                                                    <path d="M10 11v5" />
                                                    <path d="M14 11v5" />
                                                </svg>
                                            </button>
                                        </div>

                                    </td>
                                </tr>

                                number++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<DictionaryWord> words = new();

    private string searchText = string.Empty;
    private string englishWord = string.Empty;
    private string russianTranslation = string.Empty;

    private string? message;
    private string? errorMessage;
    private string? deletingWordText;

    private int? editingId;
    private int? deletingWordId;

    private bool showForm;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;

    private IEnumerable<DictionaryWord> FilteredWords
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return words;
            }

            var search = searchText.Trim();

            return words.Where(word =>
                word.EnglishWord.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                word.RussianTranslation.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWordsAsync();
    }

    private async Task LoadWordsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            words = await DbContext.DictionaryWords
                .AsNoTracking()
                .OrderBy(word => word.EnglishWord)
                .ThenBy(word => word.Id)
                .ToListAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось загрузить словарь. Проверь подключение к базе данных.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartCreate()
    {
        errorMessage = null;
        message = null;
        editingId = null;
        englishWord = string.Empty;
        russianTranslation = string.Empty;
        showForm = true;
    }

    private void StartEdit(DictionaryWord word)
    {
        errorMessage = null;
        message = null;
        editingId = word.Id;
        englishWord = word.EnglishWord;
        russianTranslation = word.RussianTranslation;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        englishWord = string.Empty;
        russianTranslation = string.Empty;
        errorMessage = null;
    }

    private async Task SaveWordAsync()
    {
        if (isSaving)
        {
            return;
        }

        var english = englishWord.Trim();
        var russian = russianTranslation.Trim();

        if (string.IsNullOrWhiteSpace(english))
        {
            errorMessage = "Введи английское слово.";
            return;
        }

        if (string.IsNullOrWhiteSpace(russian))
        {
            errorMessage = "Введи русский перевод.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        message = null;

        try
        {
            if (editingId.HasValue)
            {
                var word = await DbContext.DictionaryWords
                    .FirstOrDefaultAsync(item => item.Id == editingId.Value);

                if (word is null)
                {
                    errorMessage = "Слово не найдено. Обнови список и попробуй снова.";
                    return;
                }

                word.EnglishWord = english;
                word.RussianTranslation = russian;

                await DbContext.SaveChangesAsync();
                message = "Изменения сохранены.";
            }
            else
            {
                var word = new DictionaryWord
                {
                    EnglishWord = english,
                    RussianTranslation = russian
                };

                DbContext.DictionaryWords.Add(word);
                await DbContext.SaveChangesAsync();

                message = "Слово добавлено в словарь.";
            }

            showForm = false;
            editingId = null;
            englishWord = string.Empty;
            russianTranslation = string.Empty;

            await LoadWordsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось сохранить слово. Проверь подключение к базе данных.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartDelete(DictionaryWord word)
    {
        errorMessage = null;
        message = null;
        deletingWordId = word.Id;
        deletingWordText = $"{word.EnglishWord} — {word.RussianTranslation}";
    }

    private void CancelDelete()
    {
        deletingWordId = null;
        deletingWordText = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!deletingWordId.HasValue || isDeleting)
        {
            return;
        }

        isDeleting = true;
        errorMessage = null;
        message = null;

        try
        {
            var word = await DbContext.DictionaryWords
                .FirstOrDefaultAsync(item => item.Id == deletingWordId.Value);

            if (word is null)
            {
                errorMessage = "Слово уже отсутствует в базе данных.";
                return;
            }

            DbContext.DictionaryWords.Remove(word);
            await DbContext.SaveChangesAsync();

            message = "Слово удалено из словаря.";
            deletingWordId = null;
            deletingWordText = null;

            if (editingId == word.Id)
            {
                CancelForm();
            }

            await LoadWordsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось удалить слово. Проверь подключение к базе данных.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
