@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="admin-nav-root @(IsCollapsed ? "admin-nav-collapsed" : "")">
    <div class="admin-brand">
        <a href="/"
           class="admin-brand-link"
           title="Level English"
           @onclick="OnNavigate">
            <img src="/images/level-english-logo.svg" alt="Level English" class="admin-brand-logo" />
        </a>

        
        <button type="button"
                class="admin-collapse-button"
                @onclick="OnToggleCollapse"
                aria-label="@(IsCollapsed ? "Развернуть меню" : "Свернуть меню")"
                title="@(IsCollapsed ? "Развернуть меню" : "Свернуть меню")">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                @if (IsCollapsed)
                {
                    <path d="m9 18 6-6-6-6" />
                }
                else
                {
                    <path d="m15 18-6-6 6-6" />
                }
            </svg>
        </button>

    </div>

    <div class="admin-profile">
        <div class="admin-profile-avatar">
            @if (!string.IsNullOrWhiteSpace(AvatarUrl))
            {
                <img src="@AvatarUrl" alt="Аватар пользователя" />
            }
            else
            {
                <span>@GetInitials(DisplayName)</span>
            }
        </div>

        <div class="admin-profile-info">
            <span class="admin-profile-name">@DisplayName</span>
            <span class="admin-profile-role">Администратор</span>
        </div>
    </div>

    <nav class="admin-nav" aria-label="Основная навигация">
        <NavLink href="/students" Match="NavLinkMatch.All" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="10" cy="7" r="4" />
                    <path d="M20 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            <span class="admin-nav-text">Ученики</span>
        </NavLink>

        <NavLink href="/teachers" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="10" cy="7" r="4" />
                    <path d="M20 8v6" />
                    <path d="M23 11h-6" />
                </svg>
            </span>
            <span class="admin-nav-text">Преподаватели</span>
        </NavLink>

        <NavLink href="/programs" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    <path d="M8 7h8M8 11h8" />
                </svg>
            </span>
            <span class="admin-nav-text">Программы</span>
        </NavLink>

        <NavLink href="/Schedules" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 11h18" />
                    <path d="M8 15h2M14 15h2" />
                </svg>
            </span>
            <span class="admin-nav-text">Расписание</span>
        </NavLink>

        <NavLink href="/groups" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 20v-1a6 6 0 0 1 12 0v1" />
                    <circle cx="17" cy="9" r="2.5" />
                    <path d="M17 15a4 4 0 0 1 4 4v1" />
                </svg>
            </span>
            <span class="admin-nav-text">Группы</span>
        </NavLink>

        <NavLink href="/subscriptions" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 10h18" />
                    <path d="M7 15h4" />
                </svg>
            </span>
            <span class="admin-nav-text">Абонементы</span>
        </NavLink>

        <NavLink href="/dictionary" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5z" />
                    <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" />
                    <path d="M8 7h8M8 11h6" />
                </svg>
            </span>
            <span class="admin-nav-text">Словарь</span>
        </NavLink>

        <NavLink href="/master" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
                    <circle cx="12" cy="12" r="7" />
                    <circle cx="12" cy="12" r="2" />
                </svg>
            </span>
            <span class="admin-nav-text">Мастер</span>
        </NavLink>

        <NavLink href="/tests" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
            </span>
            <span class="admin-nav-text">Тесты</span>
        </NavLink>

        <NavLink href="/home-settings" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 10.5L12 3l9 7.5" />
                    <path d="M5 9v12h14V9" />
                    <path d="M9 21v-7h6v7" />
                </svg>
            </span>
            <span class="admin-nav-text">Главная страница</span>
        </NavLink>

        <NavLink href="/rules" Match="NavLinkMatch.Prefix" class="admin-nav-link" @onclick="OnNavigate">
            <span class="admin-nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 4h16v16H4z" />
                    <path d="M8 8h8M8 12h8M8 16h5" />
                </svg>
            </span>
            <span class="admin-nav-text">Правила</span>
        </NavLink>
    </nav>

    <div class="admin-sidebar-footer">
        <span class="admin-sidebar-footer-text">Level English</span>
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private string DisplayName { get; set; } = "Администратор";
    private string? AvatarUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            DisplayName =
                user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.FindFirst("name")?.Value
                ?? user.Identity.Name
                ?? "Администратор";

            AvatarUrl =
                user.FindFirst("avatar")?.Value
                ?? user.FindFirst("AvatarUrl")?.Value;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "А";
        }

        var parts = name.Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length > 0
                ? parts[0][..1].ToUpperInvariant()
                : "А";
        }

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
