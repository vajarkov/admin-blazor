@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="admin-nav-root @(IsCollapsed ? "admin-nav-collapsed" : "")">

    <div class="admin-brand">
        <a href="/" class="admin-brand-link" title="Level English">
            <img src="/images/level-english-logo.svg"
                 alt="Level English"
                 class="admin-brand-logo" />
        </a>

        <button type="button"
                class="admin-collapse-button"
                @onclick="OnToggleCollapse"
                aria-label="@(IsCollapsed ? "Развернуть меню" : "Свернуть меню")"
                title="@(IsCollapsed ? "Развернуть меню" : "Свернуть меню")">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                @if (IsCollapsed)
                {
                    <path d="m9 18 6-6-6-6" />
                }
                else
                {
                    <path d="m15 18-6-6 6-6" />
                }
            </svg>
        </button>
    </div>

    <div class="admin-profile" title="@displayName">
        @if (!string.IsNullOrWhiteSpace(avatarPath))
        {
            <img src="@avatarPath"
                 alt="Аватар пользователя"
                 class="admin-avatar-image" />
        }
        else
        {
            <div class="admin-avatar" aria-hidden="true">
                @GetInitials()
            </div>
        }

        <div class="admin-profile-info">
            <div class="admin-profile-name">@displayName</div>
            <div class="admin-profile-role">Администратор</div>
        </div>
    </div>

    <nav class="admin-nav" aria-label="Основная навигация">
        <div class="admin-nav-group">
            <div class="admin-nav-caption">ПОЛЬЗОВАТЕЛИ</div>

            <NavLink class="admin-nav-link"
                     href="/students"
                     Match="NavLinkMatch.All"
                     title="Студенты">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <circle cx="9" cy="8" r="3.5" />
                    <path d="M2.5 20v-1.5A5.5 5.5 0 0 1 8 13h2a5.5 5.5 0 0 1 5.5 5.5V20z" />
                    <path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14a5 5 0 0 1 3.5 4.8V20" />
                </svg>
                <span class="admin-nav-text">Студенты</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/teachers"
                     Match="NavLinkMatch.All"
                     title="Преподаватели">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.5" />
                    <path d="M5 20v-1a7 7 0 0 1 14 0v1z" />
                </svg>
                <span class="admin-nav-text">Преподаватели</span>
            </NavLink>
        </div>

        <div class="admin-nav-group">
            <div class="admin-nav-caption">ПРОГРАММЫ</div>

            <NavLink class="admin-nav-link"
                     href="/programs"
                     Match="NavLinkMatch.All"
                     title="Все программы">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M3 9h18M8 4v5M16 4v5M8 13h3M8 16h6" />
                </svg>
                <span class="admin-nav-text">Все программы</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/Schedules"
                     Match="NavLinkMatch.All"
                     title="Расписание">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3.5 2" />
                </svg>
                <span class="admin-nav-text">Расписание</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/groups"
                     Match="NavLinkMatch.All"
                     title="Группы">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="4" width="8" height="7" rx="1.5" />
                    <rect x="13" y="4" width="8" height="7" rx="1.5" />
                    <rect x="3" y="13" width="8" height="7" rx="1.5" />
                    <rect x="13" y="13" width="8" height="7" rx="1.5" />
                </svg>
                <span class="admin-nav-text">Группы</span>
            </NavLink>
        </div>

        <div class="admin-nav-group">
            <div class="admin-nav-caption">ПОДПИСКИ</div>

            <NavLink class="admin-nav-link"
                     href="/subscriptions"
                     Match="NavLinkMatch.All"
                     title="Создать новую">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <path d="M12 8v8" />
                    <path d="M8 12h8" />
                </svg>
                <span class="admin-nav-text">Создать новую</span>
            </NavLink>
        </div>

        <div class="admin-nav-group">
            <div class="admin-nav-caption">ИГРЫ</div>

            <NavLink class="admin-nav-link"
                     href="/dictionary"
                     Match="NavLinkMatch.All"
                     title="Словарь">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z" />
                    <path d="M4 5.5v16" />
                    <path d="M8 7h8" />
                    <path d="M8 11h6" />
                </svg>
                <span class="admin-nav-text">Словарь</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/nabor"
                     Match="NavLinkMatch.All"
                     title="Наборщик">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <path d="M8 9h8" />
                    <path d="M8 12h8" />
                    <path d="M8 15h5" />
                </svg>
                <span class="admin-nav-text">Наборщик</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/master"
                     Match="NavLinkMatch.All"
                     title="Мастер грамотей">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <path d="m12 3 2.6 5.3L20.5 9l-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9l5.9-.7z" />
                </svg>
