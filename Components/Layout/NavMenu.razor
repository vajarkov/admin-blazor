        </div>

        <div class="admin-nav-group">
            <div class="admin-nav-caption">ПЛАТФОРМА</div>

            <NavLink class="admin-nav-link"
                     href="/home-settings"
                     Match="NavLinkMatch.All"
                     title="Главный сайт">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M3 10 12 3l9 7" />
                    <path d="M5 9v12h14V9" />
                    <path d="M9 21v-7h6v7" />
                </svg>
                <span class="admin-nav-text">Главный сайт</span>
            </NavLink>

            <span class="admin-nav-link admin-nav-disabled"
                  title="Level-Гид">
                <svg class="admin-nav-icon" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                    <path d="M12 3 3 8l9 5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5" />
                </svg>
                <span class="admin-nav-text">Level-Гид</span>
            </span>

            <NavLink class="admin-nav-link"
                     href="/rules"
                     Match="NavLinkMatch.All"
                     title="Правила платформы">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M6 3.5h8l4 4V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z" />
                    <path d="M14 3.5V8h4" />
                    <path d="M8 12h8" />
                    <path d="M8 16h8" />
                </svg>
                <span class="admin-nav-text">Правила платформы</span>
            </NavLink>

            <NavLink class="admin-nav-link"
                     href="/privacy-policy"
                     Match="NavLinkMatch.All"
                     title="Политика конфиденциальности">
                <svg class="admin-nav-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M12 3 20 6v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-3z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                <span class="admin-nav-text">Политика конфиденциальности</span>
            </NavLink>
        </div>
    </nav>

    <div class="admin-sidebar-footer">
        <svg class="admin-nav-icon" viewBox="0 0 24 24"
             fill="none" stroke="currentColor"
             stroke-width="1.7" aria-hidden="true">
            <path d="M3 10 12 3l9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
            <path d="M9 21v-7h6v7" />
        </svg>
        <span class="admin-footer-text">Панель управления школой</span>
    </div>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    private string displayName = "Администратор";
    private string? avatarPath;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var user = authState.User;
        var name = user.FindFirst("DisplayName")?.Value;

        if (!string.IsNullOrWhiteSpace(name))
            displayName = name;

        var avatar = user.FindFirst("Avatar")?.Value;

        if (!string.IsNullOrWhiteSpace(avatar))
        {
            var fileName = Path.GetFileName(avatar.Replace('\\', '/'));
            avatarPath = $"/images/user/{Uri.EscapeDataString(fileName)}";
        }
    }

    private string GetInitials()
    {
        var parts = displayName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 0)
            return "A";

        if (parts.Length == 1)
            return parts[0][..1].ToUpperInvariant();

        return $"{parts[0][..1]}{parts[1][..1]}".ToUpperInvariant();
    }
}
